# ==============================================================================
# CONFIGURACIÓN DEL BACKEND — GYMTRACK (SUPABASE AUTH + POSTGRESQL)
# ==============================================================================
PORT=3000
FRONTEND_URL=http://localhost:5173

# Supabase (Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# SOLO EN BACKEND (NUNCA exponer en frontend ni commitear al repositorio)
# Requerida para crear/invitar cuentas de empleados y socios en Supabase Auth
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Pasarelas de pago (opcionales)
MERCADOPAGO_ACCESS_TOKEN=
UALA_CLIENT_ID=
UALA_CLIENT_SECRET=
ENABLE_MOCK_PAYMENT_SANDBOX=false
